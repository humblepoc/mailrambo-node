{
  "name": "mailrambo",
  "version": "0.1.0",
  "description": "Official Node.js client for the MailRambo email verification API - strict yes/no deliverability, disposable and catch-all detection.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": ["index.js", "index.d.ts", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": { "test": "node --test" },
  "keywords": ["email", "email-verification", "email-validation", "verify-email", "disposable-email", "catch-all", "bounce", "deliverability", "mailrambo"],
  "homepage": "https://www.mailrambo.com/developers",
  "repository": { "type": "git", "url": "git+https://github.com/humblepoc/mailrambo-node.git" },
  "license": "MIT",
  "author": "iodevz <hello@mailrambo.com>"
}
